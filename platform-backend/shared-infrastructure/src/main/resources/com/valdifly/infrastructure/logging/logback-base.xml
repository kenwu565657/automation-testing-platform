<!-- Shared JSON logging base, shipped inside shared-infrastructure.
     Each service includes it from its own logback config:

       Spring Boot (logback-spring.xml):
         <configuration>
             <springProperty name="SERVICE_NAME" source="spring.application.name"/>
             <include resource="com/valdifly/infrastructure/logging/logback-base.xml"/>
         </configuration>

       Plain logback (logback.xml):
         <configuration>
             <property name="SERVICE_NAME" value="engine-service"/>
             <include resource="com/valdifly/infrastructure/logging/logback-base.xml"/>
         </configuration>

     Everything from the MDC (traceId, spanId, correlationId, userId — see LogFields)
     lands in each line, so micrometer-tracing trace ids finally reach the logs.
     SERVICE_NAME and LOG_ROOT_LEVEL are the two knobs; both have defaults. -->
<included>
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"${SERVICE_NAME:-unnamed-service}"}</customFields>
        </encoder>
    </appender>

    <root level="${LOG_ROOT_LEVEL:-INFO}">
        <appender-ref ref="JSON_CONSOLE"/>
    </root>

    <!-- Quiet the chatty libraries on every service, per report-service's logback.xml -->
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="io.lettuce" level="WARN"/>
</included>
