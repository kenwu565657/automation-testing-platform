{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-document.schema.json",
  "title": "ExecutionAssignment",
  "type": "object",
  "required": ["assignmentId", "request"],
  "properties": {
    "assignmentId": { "type": "string" },
    "request": { "type": "object", "description": "Admin DomainEventEnvelope for test.execution.request" },
    "execution": {
      "type": "object",
      "description": "Self-contained case. A non-Java engine runs this and does not open Postgres.",
      "properties": {
        "testCaseName": { "type": "string" },
        "testType": { "enum": ["WEB_E2E", "MOBILE_E2E", "API", "LOAD_TEST"] },
        "variables": { "type": "object", "additionalProperties": { "type": "string" } },
        "remoteUrl": { "type": ["string", "null"] },
        "udid": { "type": ["string", "null"] },
        "steps": { "type": "array" }
      }
    }
  }
}
