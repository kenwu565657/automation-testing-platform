{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engine-event.schema.json",
  "title": "EngineEvent",
  "type": "object",
  "required": ["eventType", "runId", "testCaseId"],
  "properties": {
    "eventType": {
      "enum": ["test.run.started", "test.step.completed", "test.run.completed"]
    },
    "runId": { "type": "string" },
    "testCaseId": { "type": "string" },
    "executionId": { "type": "string" },
    "testType": { "type": "string" },
    "definitionVersion": { "type": "integer", "minimum": 1, "description": "The pinned definition version this result executed; engines echo it from the assignment request" },
    "status": { "type": "string" },
    "errorMessage": { "type": "string" },
    "requestCount": { "type": "integer" },
    "failedCount": { "type": "integer" },
    "p95ResponseTimeMs": { "type": "integer" },
    "stepResults": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "stepId": { "type": "string" },
            "orderIndex": { "type": "integer" },
            "stepText": { "type": "string" },
            "keyword": { "type": "string" },
            "status": { "type": "string" },
            "durationMs": { "type": "integer" },
            "errorMessage": { "type": "string" },
            "screenshotPath": { "type": "string", "description": "Object-store artifact key (Java engine); the TS engine currently emits a local /tmp path" }
          }
        }
      }
  },
  "description": "Posted to the coordinator. The coordinator publishes the same JSON on the eventType topic."
}
