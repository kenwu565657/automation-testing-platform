COMPOSE_PROJECT_NAME=valdifly

# ── Versions ──
POSTGRES_VERSION=17.4
KAFKA_VERSION=4.0.0
ELASTICSEARCH_VERSION=8.16.1
KIBANA_VERSION=8.16.1
REDIS_VERSION=7.4
FLOCI_VERSION=2.0.1
PROMETHEUS_VERSION=v2.55.1
GRAFANA_VERSION=11.5.2
ALERTMANAGER_VERSION=v0.27.0
TEMPO_VERSION=2.6.1
OTEL_COLLECTOR_VERSION=0.119.0
NGINX_VERSION=1.27-alpine
REDISINSIGHT_VERSION=2.66
ZOONAVIGATOR_VERSION=1.1.3
ELASTICJOB_UI_VERSION=3.0.2
S3MANAGER_VERSION=v0.12.0

# ── PostgreSQL ──
POSTGRES_DB=testplatform
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform123

# ── Elasticsearch ──
ES_JAVA_OPTS=-Xms512m -Xmx512m

# ── Object store (Floci local) ──
S3_BUCKET=valdifly-artifacts

# ── Local tools (Compose --profile tools) ──
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Admin JWT (local only; replace outside this machine) ──
JWT_SECRET=local-dev-only-jwt-hmac-secret-32b

# ── Admin language model (OpenAI-compatible; optional) ──
# Cloud example: https://api.openai.com/v1
# Local Ollama: http://host.docker.internal:11434/v1
PLATFORM_AI_BASE_URL=
PLATFORM_AI_API_KEY=
PLATFORM_AI_MODEL=gpt-4.1-mini
# Encrypts per-user keys. Defaults to JWT_SECRET when empty.
PLATFORM_AI_SETTINGS_SECRET=